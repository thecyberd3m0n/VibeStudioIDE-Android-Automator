<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.vibestudio.automator"
    android:versionCode="2" android:versionName="0.2">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /></intent>
        <package android:name="com.vibestudio.app" />
        <package android:name="com.vibestudio.app.debug" />
        <package android:name="com.vibestudio.dev" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application android:name=".AutomatorApp" android:label="VibeStudio Automator"
        android:allowBackup="false" android:theme="@style/AppTheme">
        <activity android:name=".CrashActivity" android:process=":crash_process"
            android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.AgentBubbleActivity" android:exported="true"
            android:taskAffinity="" android:allowEmbedded="true"
            android:documentLaunchMode="always" android:resizeableActivity="true" />
        <service android:name=".driver.VibeAccessibilityService" android:exported="false"
            android:label="VibeStudio Automator"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>
        <service android:name=".ipc.AutomatorBoundService" android:exported="true">
            <intent-filter><action android:name="dev.vibestudio.automator.ACTION_BIND" /></intent-filter>
        </service>
        <receiver android:name=".hud.BubbleActionReceiver" android:exported="false" />
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="dev.vibestudio.automator.shizuku"
            android:exported="true" android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
